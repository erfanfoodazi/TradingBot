<Window
    x:Class="TradingBot.UI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Trading Bot"
    Width="1200"
    Height="800">

   
    <Grid>

        <StackPanel
        HorizontalAlignment="Center"
        VerticalAlignment="Center">

            <TextBlock
            FontSize="30"
            Text="{Binding Title}" />

            <TextBlock
            Margin="0,10,0,0"
            FontSize="18"
            Text="{Binding Status}" />

        </StackPanel>

    </Grid>

</Window>